---
import Base from "../layouts/Base.astro";

// TODO: replace with the real Web3Forms access key from web3forms.com before going live.
const WEB3FORMS_ACCESS_KEY = "200a2578-6149-45a0-babe-451b63288b74";
---

<Base
  title="Contact"
  description="Get in touch about scaling your Amazon, Walmart, Target, or TikTok Shop advertising."
>
  <section class="section">
    <div class="container-page max-w-2xl">
      <p class="eyebrow text-center">Contact</p>
      <h1 class="mt-3 text-center text-4xl font-semibold tracking-tight text-navy md:text-5xl">
        Let's scale your advertising
      </h1>
      <p class="mx-auto mt-5 max-w-md text-center text-lg text-slate">
        Ready to accelerate growth? Fill out the form to connect.
      </p>

      <form id="contact-form" class="card mt-12 space-y-6 p-8 md:p-10">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New inquiry from nawalbashir.com" />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="first_name" class="text-xs font-semibold uppercase tracking-wide text-slate">First Name</label>
            <input
              id="first_name"
              name="first_name"
              type="text"
              required
              class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-navy"
            />
          </div>
          <div>
            <label for="last_name" class="text-xs font-semibold uppercase tracking-wide text-slate">Last Name</label>
            <input
              id="last_name"
              name="last_name"
              type="text"
              required
              class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-navy"
            />
          </div>
        </div>

        <div>
          <label for="phone" class="text-xs font-semibold uppercase tracking-wide text-slate">Phone Number</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-navy"
          />
        </div>

        <div>
          <label for="email" class="text-xs font-semibold uppercase tracking-wide text-slate">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-2 w-full rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-navy"
          />
        </div>

        <div>
          <label for="message" class="text-xs font-semibold uppercase tracking-wide text-slate">Message</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            placeholder="Type your message..."
            class="mt-2 w-full resize-none rounded-xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-navy"
          ></textarea>
        </div>

        <button type="submit" class="btn-primary w-full justify-center">Submit</button>

        <p id="form-status" class="hidden text-center text-sm" role="status"></p>
      </form>

      <p class="mt-8 text-center text-sm text-slate">
        Prefer email? Reach out directly at{" "}
        <a href="mailto:hello@nawalbashir.com" class="font-medium text-navy hover:underline">hello@nawalbashir.com</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    const key = (form.elements.namedItem("access_key") as HTMLInputElement)?.value;
    if (!key || key === "REPLACE_WITH_WEB3FORMS_ACCESS_KEY") {
      status.textContent = "Form isn't fully configured yet — missing Web3Forms access key.";
      status.className = "text-center text-sm text-red-600";
      return;
    }

    const submitBtn = form.querySelector("button[type=submit]") as HTMLButtonElement;
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const result = await res.json();

      if (result.success) {
        form.reset();
        status.textContent = "Thanks — your message has been sent. I'll be in touch soon.";
        status.className = "text-center text-sm text-navy";
      } else {
        status.textContent = "Something went wrong. Please try again or email hello@nawalbashir.com directly.";
        status.className = "text-center text-sm text-red-600";
      }
    } catch {
      status.textContent = "Something went wrong. Please try again or email hello@nawalbashir.com directly.";
      status.className = "text-center text-sm text-red-600";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit";
    }
  });
</script>
