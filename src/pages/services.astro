---
import Base from "../layouts/Base.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import CTASection from "../components/CTASection.astro";
import { services } from "../data/services";
---

<Base
  title="Services"
  description="Advertising management across Amazon, Walmart, Target, TikTok Shop, and Amazon Marketing Cloud — led directly, built around profitability."
>
  <section class="section pb-10">
    <div class="container-page max-w-2xl">
      <p class="eyebrow text-center">Services</p>
      <h1 class="mt-3 text-center text-4xl font-semibold tracking-tight text-navy md:text-5xl">
        Advertising Services Built for Scalable Growth
      </h1>
      <p class="mx-auto mt-5 max-w-xl text-center text-lg text-slate">
        One strategist, every channel — plug in where you need help, or hand over the whole
        advertising function.
      </p>
    </div>
  </section>

  <section class="container-page mt-6 max-w-3xl divide-y divide-line">
    {services.map((s) => (
      <div class="grid gap-6 py-14 sm:grid-cols-[auto_1fr] sm:gap-10">
        <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-navy/5 text-navy">
          <ServiceIcon name={s.icon as any} class="h-7 w-7" />
        </div>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-navy">{s.title}</h2>
          <p class="mt-3 text-base leading-relaxed text-ink/80">{s.long}</p>
        </div>
      </div>
    ))}
  </section>

  <CTASection
    heading="Ready to plug me into your account?"
    body="Tell me which channels you're on and where the friction is — I'll take it from there."
    cta="audit"
  />
</Base>
