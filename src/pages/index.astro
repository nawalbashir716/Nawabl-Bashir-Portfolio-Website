---
import Base from "../layouts/Base.astro";
import LogoStrip from "../components/LogoStrip.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import Testimonials from "../components/Testimonials.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import CTASection from "../components/CTASection.astro";
import CTAButton from "../components/CTAButton.astro";
import StatsRow from "../components/StatsRow.astro";
import { getCollection } from "astro:content";

const pillars = [
  {
    title: "Custom-Built Strategies",
    body: "Every brand gets a tailored strategy based on its niche, catalog structure, and growth goals.",
  },
  {
    title: "Profit-First Advertising",
    body: "Focus on sustainable growth and profitability rather than vanity metrics. No hidden fees, no percentage of ad spend — just a flat retainer that only grows when your results grow.",
  },
  {
    title: "Multi-Platform Expertise",
    body: "Experience across Amazon, Walmart, Target, and TikTok Shop.",
  },
  {
    title: "Transparent Reporting",
    body: "Clear communication, structured reporting, and actionable insights.",
  },
  {
    title: "Proven Track Record",
    body: "Experience working with multiple agencies and scaling brands across marketplaces — with 90%+ client retention along the way.",
  },
  {
    title: "All-In-One Advertising Partner",
    body: "Strategy, execution, optimization, and scaling handled end-to-end.",
  },
];

const allCaseStudies = await getCollection("case-studies");
const featuredSlugs = ["case-study-01", "case-study-07", "case-study-06"];
const featured = featuredSlugs
  .map((slug) => allCaseStudies.find((cs) => cs.id === slug))
  .filter(Boolean);
---

<Base
  title="Retail Media Partner"
  description="Retail media partner driving growth across Amazon, Walmart, Target, and TikTok Shop — with a focus on profitability, not just ad spend."
>
  <!-- Hero -->
  <section class="pb-0 pt-20 md:pt-28">
    <div class="container-page grid items-center gap-14 md:grid-cols-[1.15fr_0.85fr] md:gap-12">
      <div>
        <h1 class="text-5xl font-semibold leading-[1.12] tracking-tight text-navy md:text-6xl">
          Retail Media Partner for <span class="whitespace-nowrap">E-Commerce</span> Brands
        </h1>
        <p class="mt-7 max-w-lg text-lg leading-relaxed text-slate md:text-xl">
          Driving growth across Amazon, Walmart, Target, and TikTok Shop — with a focus on{" "}
          <em class="font-display italic text-navy">profitability</em>, not just ad spend.
        </p>
        <div class="mt-10">
          <CTAButton label="Get in Touch" />
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-[280px] md:max-w-[320px]">
        <div class="overflow-hidden rounded-[1.75rem] bg-mist shadow-[0_30px_60px_-30px_rgba(15,42,92,0.35)]">
          <img
            src="/images/personal/hero.jpg"
            alt="Nawal Bashir"
            class="aspect-[4/5] h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="container-page mt-16">
    <StatsRow />
  </section>

  <div class="mt-16">
    <LogoStrip />
  </div>

  <!-- Why brands choose to work with me -->
  <section class="section" id="why">
    <div class="container-page">
      <h2 class="text-center text-4xl font-semibold tracking-tight text-navy md:text-5xl">
        Why brands choose to work with me
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-center text-slate">
        Built around your results and growth, not around a task list.
      </p>

      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {pillars.map((p) => (
          <div class="card p-8">
            <h3 class="text-lg font-semibold text-navy">{p.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ServicesGrid />

  <!-- Case studies preview -->
  <section class="section" id="work">
    <div class="container-page">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2 class="text-4xl font-semibold tracking-tight text-navy md:text-5xl">
            Real results from real brands
          </h2>
        </div>
        <a href="/case-studies" class="btn-secondary shrink-0">View All Case Studies</a>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {featured.map((cs) => cs && (
          <CaseStudyCard
            slug={cs.id}
            title={cs.data.title}
            category={cs.data.category}
            stat={cs.data.stats[0]}
            image={cs.data.images[0]}
          />
        ))}
      </div>
    </div>
  </section>

  <Testimonials />
  <CTASection cta="audit" />
</Base>
