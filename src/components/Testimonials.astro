---
// Unified testimonials — clients and colleagues shown together, no labeling distinction (per Nawal's instruction).
const testimonials = [
  {
    quote:
      "I was working with My Amazon Guy before, so switching to in-house… tbh wasn't sure. But Nawal changed that. Within 3 months of bringing him on, we hit highest monthly revenue, while staying within our TACoS targets. Biweekly calls with him are effective and he always brings great recommendations. I am not an easy client to work with and I appreciate the hard work.",
    name: "Junior Gupta",
    role: "HomeSpice",
    logo: "/images/logos/clients/homespice.png",
  },
  {
    quote:
      "Really solid working with Nawal. Very proactive. Strong on problem solving. Communication is clear. Execution is strong, things actually get done.",
    name: "Tim Kopnia",
    role: "XP Strategy",
    logo: "/images/logos/clients/xp-strategy.png",
  },
  {
    quote:
      "Having worked with 2 different agencies before, this level of ownership and follow-through is rare. Nawal's very strong with the data, but also explains things in a way that actually makes sense. Good communication.",
    name: "Arby Coin",
    role: "Great Eagle Lightning Corporation",
    logo: "/images/logos/clients/great-eagle.png",
  },
  {
    quote:
      "His work is clean, reporting is very detailed, and always on time. Takes ownership, helps beyond just his scope, and you can rely on him to deliver. Communication is clear, consistent. Just reliable overall.",
    name: "Matthew Koski",
    role: "Envision Horizons",
    logo: "/images/logos/clients/envision-horizons.png",
  },
];
---

<section class="section" id="testimonials">
  <div class="container-page">
    <h2 class="text-center text-4xl font-semibold tracking-tight text-navy md:text-5xl">
      What People I've Worked With Say
    </h2>

    <div class="relative mx-auto mt-14 max-w-2xl">
      <div id="testimonial-track" class="overflow-hidden">
        <div id="testimonial-slides" class="flex transition-transform duration-700 ease-out">
          {testimonials.map((t) => (
            <div class="w-full shrink-0 px-2">
              <div class="card p-8 md:p-10">
                <div class="flex gap-1 text-blue" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M10 1.5l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3-5.4 3 1.3-6-4.6-4.1 6.1-.6z" />
                    </svg>
                  ))}
                </div>
                <p class="mt-5 text-lg leading-relaxed text-ink/90">"{t.quote}"</p>
                <div class="mt-6 flex items-center justify-between gap-4 border-t border-line pt-5">
                  <div>
                    <p class="font-semibold text-navy">{t.name}</p>
                    <p class="text-sm text-slate">{t.role}</p>
                  </div>
                  <img src={t.logo} alt={t.role} class="h-7 w-auto max-w-[110px] object-contain opacity-80" loading="lazy" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="mt-6 flex justify-center gap-2" id="testimonial-dots">
        {testimonials.map((_, i) => (
          <button
            class="h-2 w-2 rounded-full bg-line transition-colors data-[active=true]:bg-navy"
            data-index={i}
            aria-label={`Show testimonial ${i + 1}`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const slides = document.getElementById("testimonial-slides");
  const dots = Array.from(document.querySelectorAll("#testimonial-dots button"));
  const track = document.getElementById("testimonial-track");
  if (slides && track && dots.length) {
    let index = 0;
    let timer: ReturnType<typeof setInterval>;

    const render = () => {
      slides.style.transform = `translateX(-${index * 100}%)`;
      dots.forEach((d, i) => d.setAttribute("data-active", String(i === index)));
    };

    const next = () => {
      index = (index + 1) % dots.length;
      render();
    };

    const start = () => (timer = setInterval(next, 5500));
    const stop = () => clearInterval(timer);

    dots.forEach((dot, i) =>
      dot.addEventListener("click", () => {
        index = i;
        render();
      })
    );

    track.addEventListener("mouseenter", stop);
    track.addEventListener("mouseleave", start);

    render();
    start();
  }
</script>
