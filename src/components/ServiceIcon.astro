---
interface Props {
  name: "cart" | "spark" | "target" | "play" | "cloud";
  class?: string;
}
const { name, class: className = "h-6 w-6" } = Astro.props;
---

{name === "cart" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
    <circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="18" cy="20" r="1.4" fill="currentColor" stroke="none" />
    <path d="M2.5 3h2.4l2.1 11.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 7H6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
)}
{name === "spark" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class={className}>
    <path d="M12 3v6M12 15v6M5 6l4.5 4.2M14.5 13.8L19 18M19 6l-4.5 4.2M9.5 13.8L5 18" />
  </svg>
)}
{name === "target" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
    <circle cx="12" cy="12" r="9" />
    <circle cx="12" cy="12" r="5" />
    <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
  </svg>
)}
{name === "play" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class={className}>
    <rect x="3" y="3" width="18" height="18" rx="5" />
    <path d="M10 8.5l6 3.5-6 3.5z" fill="currentColor" stroke="none" />
  </svg>
)}
{name === "cloud" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
    <path d="M7 18a4 4 0 0 1-.5-7.97A5 5 0 0 1 16.2 8.1 4.5 4.5 0 0 1 17.5 17H7z" />
    <path d="M9 21v-3M12 21v-4.5M15 21v-2.5" />
  </svg>
)}
