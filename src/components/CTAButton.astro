---
interface Props {
  label: "Get a Free Audit" | "Get in Touch";
  size?: "sm" | "md";
  invert?: boolean;
}
const { label, size = "md", invert = false } = Astro.props;

const pad = size === "sm" ? "px-5 py-2.5 text-sm" : "px-7 py-3.5 text-sm";
---

<a
  href="/contact"
  class:list={[
    invert
      ? "inline-flex items-center justify-center rounded-xl bg-white font-medium text-navy transition hover:bg-mist"
      : "btn-primary",
    pad,
  ]}
>
  {label}
</a>
