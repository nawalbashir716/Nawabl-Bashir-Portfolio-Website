---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex shrink-0 items-center justify-center rounded-xl bg-navy font-display text-sm font-semibold tracking-wide text-white",
    className,
  ]}
  aria-hidden="true"
>
  NB
</span>
