---
const stats = [
  { target: 80, prefix: "$", suffix: "M+", label: "Revenue Generated" },
  { target: 7, prefix: "$", suffix: "M+", label: "Ad Spend Managed" },
  { target: 45, prefix: "", suffix: "+", label: "Brands Managed" },
  { target: 5, prefix: "", suffix: "+ Years", label: "Experience" },
];
---

<div class="stats-row grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
  {stats.map((s) => (
    <div class="rounded-2xl border border-line bg-mist/60 px-4 py-8 text-center">
      <p
        class="counter font-display text-3xl font-semibold text-navy md:text-4xl"
        data-target={s.target}
        data-prefix={s.prefix}
        data-suffix={s.suffix}
      >
        {s.prefix}0{s.suffix}
      </p>
      <p class="mt-1.5 text-xs font-medium uppercase tracking-wide text-slate md:text-sm">{s.label}</p>
    </div>
  ))}
</div>

<script>
  const rows = document.querySelectorAll<HTMLElement>(".stats-row");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target);
    const prefix = el.dataset.prefix ?? "";
    const suffix = el.dataset.suffix ?? "";

    if (prefersReducedMotion) {
      el.textContent = `${prefix}${target}${suffix}`;
      return;
    }

    const duration = 1400;
    const start = performance.now();

    const tick = (now: number) => {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = Math.round(target * eased);
      el.textContent = `${prefix}${value}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  };

  rows.forEach((row) => {
    const counters = Array.from(row.querySelectorAll<HTMLElement>(".counter"));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            counters.forEach(animate);
            observer.disconnect();
          }
        });
      },
      { threshold: 0.4 }
    );
    observer.observe(row);
  });
</script>
