---
import CTAButton from "./CTAButton.astro";

const year = new Date().getFullYear();
const PHONE = "+1 (771) 220-4872";
const LINKEDIN_URL = "https://www.linkedin.com/in/nawalbashir";
---

<footer class="border-t border-line bg-mist">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-xl font-semibold text-navy">Nawal Bashir</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-slate">
        Take the stress of advertising off your plate. Get a free account audit and a
        personalized growth plan to identify opportunities for profitable growth.
      </p>
      <div class="mt-6">
        <CTAButton label="Get in Touch" size="sm" />
      </div>
    </div>

    <div>
      <p class="eyebrow">Quick Links</p>
      <ul class="mt-4 space-y-2.5 text-sm text-ink/80">
        <li><a href="/" class="hover:text-navy">Home</a></li>
        <li><a href="/about" class="hover:text-navy">About</a></li>
        <li><a href="/services" class="hover:text-navy">Services</a></li>
        <li><a href="/case-studies" class="hover:text-navy">Case Studies</a></li>
        <li><a href="/contact" class="hover:text-navy">Contact</a></li>
      </ul>
    </div>

    <div>
      <p class="eyebrow">Contact Info</p>
      <ul class="mt-4 space-y-2.5 text-sm text-ink/80">
        <li><a href="mailto:hello@nawalbashir.com" class="hover:text-navy">hello@nawalbashir.com</a></li>
        <li><a href={`tel:${PHONE.replace(/[^+\d]/g, "")}`} class="hover:text-navy">{PHONE}</a></li>
        <li>
          <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-navy">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="#0A66C2" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-slate md:flex-row md:items-center md:justify-between">
      <p>© {year} Nawal Bashir. All rights reserved.</p>
    </div>
  </div>
</footer>
